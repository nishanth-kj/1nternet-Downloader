<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/classic_panel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/classic_blue"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Internet Downloader"
                android:textColor="@color/classic_white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnToolbarAdd"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/classic_white"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Add"
                android:textColor="@color/classic_blue"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnOpenMenu"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/classic_white"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Menu"
                android:textColor="@color/classic_blue"
                android:textSize="13sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/filterScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/classic_chrome"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:checked="true"
                    android:text="All" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipActive"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="Active" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCompleted"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="Completed" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTorrents"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="Torrents" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipVideos"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="Videos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCompressed"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="Compressed" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPrograms"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="Programs" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDocuments"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="Documents" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDownloads"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/classic_white"
                android:clipToPadding="false" />

            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Downloads Yet"
                    android:textColor="@color/classic_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Use Add or the Menu on the right to start a download"
                    android:textColor="@color/classic_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/browserPane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/classic_white"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/classic_chrome"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <Button
                        android:id="@+id/btnBrowserBack"
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:backgroundTint="@color/classic_panel"
                        android:text="&lt;"
                        android:textColor="@color/classic_text" />

                    <EditText
                        android:id="@+id/etBrowserUrl"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginHorizontal="6dp"
                        android:layout_weight="1"
                        android:background="@color/classic_white"
                        android:hint="https://"
                        android:imeOptions="actionGo"
                        android:inputType="textUri"
                        android:paddingHorizontal="8dp"
                        android:singleLine="true"
                        android:text="https://"
                        android:textColor="@color/classic_text"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnBrowserGo"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="@color/classic_blue"
                        android:text="Go"
                        android:textColor="@color/classic_white" />
                </LinearLayout>

                <WebView
                    android:id="@+id/webView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/classic_chrome"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabDownloads"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/classic_blue"
                android:gravity="center"
                android:text="Downloads"
                android:textColor="@color/classic_white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabBrowser"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Browser"
                android:textColor="@color/classic_text"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/rightMenu"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/classic_chrome"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Tasks"
                android:textColor="@color/classic_text"
                android:textStyle="bold" />

            <Button android:id="@+id/menuAddUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/classic_panel" android:text="Add URL" android:textAlignment="textStart" android:textColor="@color/classic_text" />
            <Button android:id="@+id/menuAddTorrent" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/classic_panel" android:text="Add Torrent" android:textAlignment="textStart" android:textColor="@color/classic_text" />
            <Button android:id="@+id/menuPause" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/classic_panel" android:text="Pause" android:textAlignment="textStart" android:textColor="@color/classic_text" />
            <Button android:id="@+id/menuResume" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/classic_panel" android:text="Resume" android:textAlignment="textStart" android:textColor="@color/classic_text" />
            <Button android:id="@+id/menuRestart" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/classic_panel" android:text="Restart" android:textAlignment="textStart" android:textColor="@color/classic_text" />
            <Button android:id="@+id/menuDelete" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/classic_panel" android:text="Delete" android:textAlignment="textStart" android:textColor="@color/classic_text" />
            <Button android:id="@+id/menuOpenFile" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/classic_panel" android:text="Open File" android:textAlignment="textStart" android:textColor="@color/classic_text" />
            <Button android:id="@+id/menuOpenFolder" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/classic_panel" android:text="Open Folder" android:textAlignment="textStart" android:textColor="@color/classic_text" />
            <Button android:id="@+id/menuCopyUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/classic_panel" android:text="Copy URL" android:textAlignment="textStart" android:textColor="@color/classic_text" />
            <Button android:id="@+id/menuViewSegments" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/classic_panel" android:text="View Segments" android:textAlignment="textStart" android:textColor="@color/classic_text" />
            <Button android:id="@+id/menuPauseAll" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/classic_panel" android:text="Pause All" android:textAlignment="textStart" android:textColor="@color/classic_text" />
            <Button android:id="@+id/menuResumeAll" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/classic_panel" android:text="Resume All" android:textAlignment="textStart" android:textColor="@color/classic_text" />
            <Button android:id="@+id/menuClearCompleted" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/classic_panel" android:text="Clear Completed" android:textAlignment="textStart" android:textColor="@color/classic_text" />
            <Button android:id="@+id/menuAbout" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/classic_panel" android:text="About" android:textAlignment="textStart" android:textColor="@color/classic_text" />
        </LinearLayout>
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
