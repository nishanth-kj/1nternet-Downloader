{
  "manifest_version": 3,
  "name": "Internet Downloader Integration",
  "version": "1.0.0",
  "description": "Seamlessly integrate your browser with Internet Downloader for fast, multi-threaded downloading.",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Internet Downloader"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
